# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Codex / app runtime artifacts
.codex-logs/
.codex-previews/
# Runtime asset storage at repo root only — do NOT match src/services/storage/
/storage/

# Eval harness (R12 / Phase 0). The golden source images are large
# (200MB+ of PNGs) and the generated results are reproducible from the
# harness — neither belongs in git. Only the README + .gitkeep are
# tracked so the folder structure and usage guide survive a clone.
/eval/results/
/eval/golden/*
!/eval/golden/README.md
!/eval/golden/.gitkeep
# Throwaway upload archive (created when zipping the golden set to share).
/eval.zip

# any local SQLite databases (legacy from the SQLite era — repo runs on Postgres now)
*.db
*.db-journal
