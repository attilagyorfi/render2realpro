generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  // bcrypt hash; nullable for now so the JSON-profile migration can land
  // without backfilling passwords. Sprint 2.3 will require it.
  passwordHash String?
  // Role-based authorization. "user" is the default; "admin" unlocks the
  // /app/admin surface and the /api/admin/* endpoints. There is no UI for
  // promoting users yet — flip the field in the DB (psql or Prisma Studio)
  // to grant admin access.
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  projects     Project[]

  @@index([email])
}

model Project {
  id                  String       @id @default(cuid())
  name                String
  description         String?
  clientName          String?
  coverImageAssetId   String?
  shareToken          String?      @unique
  // Optional expiry; null means "never expires". Sprint 2.4 added.
  shareTokenExpiresAt DateTime?
  // Public-view counter; reset to 0 when the token is regenerated.
  shareTokenViewCount Int          @default(0)
  // Optional during the JSON→DB migration; Sprint 2.x will tighten to
  // non-nullable once the data backfill has run on every environment.
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  imageAssets         ImageAsset[]

  // Dashboard lists projects sorted by createdAt desc — per user.
  @@index([userId, createdAt])
  @@index([createdAt])
}

model ImageAsset {
  id               String           @id @default(cuid())
  projectId        String
  originalFileName String
  storedFilePath   String
  previewPath      String
  imageType        String
  mimeType         String
  width            Int
  height           Int
  size             Int
  status           ImageAssetStatus @default(ready)
  createdAt        DateTime         @default(now())
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageVersions    ImageVersion[]
  generationLogs   GenerationLog[]

  // Hot lookup: list/order assets within a project.
  @@index([projectId, createdAt])
  // Filter assets by status (e.g. find all currently processing).
  @@index([status])
}

model ImageVersion {
  id           String           @id @default(cuid())
  imageAssetId String
  versionType  ImageVersionType
  filePath     String
  promptUsed   String?
  presetUsed   String?
  settingsJson String
  metadataJson String?
  createdAt    DateTime         @default(now())
  imageAsset   ImageAsset       @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)

  // Hot lookup: list versions for an asset, newest first.
  @@index([imageAssetId, createdAt])
  // Filter by version type within an asset (e.g. originals only).
  @@index([imageAssetId, versionType])
}

model Preset {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  category     String
  settingsJson String
  createdAt    DateTime @default(now())

  // Preset list filtered by category.
  @@index([category])
}

model GenerationLog {
  id             String              @id @default(cuid())
  imageAssetId   String
  jobType        String              @default("realism_pass")
  providerName   String
  promptVersion  String
  settingsJson   String
  success        Boolean
  errorMessage   String?
  processingTime Int
  status         GenerationLogStatus @default(queued)
  createdAt      DateTime            @default(now())
  imageAsset     ImageAsset          @relation(fields: [imageAssetId], references: [id], onDelete: Cascade)

  // History panel lists logs by asset and recency.
  @@index([imageAssetId, createdAt])
  // Surface the active queue across the dashboard.
  @@index([status, createdAt])
}

enum ImageVersionType {
  original
  realism_pass
  texture_pass
  edited
  final
}

enum ImageAssetStatus {
  ready
  processing
  failed
}

enum GenerationLogStatus {
  queued
  processing
  completed
  failed
}
