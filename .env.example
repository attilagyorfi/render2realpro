# ─── Required ──────────────────────────────────────────────────────────────
# SQLite database for projects, assets, versions, presets, and logs.
DATABASE_URL="file:./dev.db"

# Absolute or relative path where uploads, previews, and generated versions
# are stored on the local filesystem.
RENDER2REAL_STORAGE_ROOT="./storage"

# HMAC secret used to sign the session cookie. Required in production
# (process refuses to start without it). At least 32 characters; generate
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# In development, a per-process random secret is generated automatically
# and sessions invalidate on every restart.
RENDER2REAL_SESSION_SECRET=""

# ─── Provider selection ────────────────────────────────────────────────────
# One of: "mock-local" | "fal-controlnet" | "openai-image-editing".
# Falls back to "mock-local" if the requested provider isn't configured.
RENDER2REAL_ACTIVE_PROVIDER="mock-local"

# ─── Fal.ai (primary, direct integration via @fal-ai/client) ───────────────
# Fal.ai API key. Get one at https://fal.ai → Dashboard → API Keys.
# Required when RENDER2REAL_ACTIVE_PROVIDER="fal-controlnet".
FAL_KEY=""

# Override the default Fal model. Default: fal-ai/flux-pro/v1/canny.
# Other options worth trying: fal-ai/flux-control-net-canny, fal-ai/flux-pro/new.
# FAL_MODEL="fal-ai/flux-pro/v1/canny"

# Fal model tuning. Defaults are calibrated for architectural fidelity.
# Lower controlnet_conditioning_scale = more creative, less faithful to the
# source geometry. 0.75 is the architectural sweet spot.
# FAL_CONTROL_WEIGHT="0.75"
# FAL_INFERENCE_STEPS="28"
# FAL_GUIDANCE_SCALE="3.5"

# Legacy: URL of the optional render2real-api FastAPI microservice. Only
# used by the texture-targeting inpainting feature, not by the main
# realism-pass pipeline. Leave unset if you don't run that service.
# RENDER2REAL_API_URL="http://localhost:8000"

# ─── OpenAI (legacy — not recommended for architectural fidelity) ──────────
# Takes priority over OPENAI_API_KEY so a system-level OpenAI key (e.g. a
# Manus proxy key) cannot accidentally hijack this project's key.
RENDER2REAL_PROVIDER_API_KEY=""
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
