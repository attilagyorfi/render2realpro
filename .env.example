# ─── Required ──────────────────────────────────────────────────────────────
# Postgres connection string. The default below matches the docker-compose
# service in this repo (`docker compose up -d` then `npm run db:push`).
# Host port is 5433, not the Postgres default of 5432, so it doesn't clash
# with a native Postgres install on the same machine. (If you're sure
# nothing else is using 5432, you can change docker-compose.yml and this
# value back to 5432.)
#
# On Railway / Fly / Neon this is injected automatically by the platform
# as a postgresql:// URL — do not set it manually in production.
DATABASE_URL="postgresql://render2real:render2real_dev@localhost:5433/render2real_dev"

# Absolute or relative path where uploads, previews, and generated versions
# are stored on the local filesystem. On Railway/Fly point this at the
# mounted persistent volume (e.g. /data/storage).
RENDER2REAL_STORAGE_ROOT="./storage"

# HMAC secret used to sign the session cookie. Required in production
# (process refuses to start without it). At least 32 characters; generate
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# In development, a per-process random secret is generated automatically
# and sessions invalidate on every restart.
RENDER2REAL_SESSION_SECRET=""

# ─── Provider selection ────────────────────────────────────────────────────
# One of: "mock-local" | "fal-controlnet" | "openai-image-editing".
# Falls back to "mock-local" if the requested provider isn't configured.
RENDER2REAL_ACTIVE_PROVIDER="mock-local"

# ─── Fal.ai (primary, direct integration via @fal-ai/client) ───────────────
# Fal.ai API key. Get one at https://fal.ai → Dashboard → API Keys.
# Required when RENDER2REAL_ACTIVE_PROVIDER="fal-controlnet".
FAL_KEY=""

# Override the default realism-pass model. Default (R14):
# fal-ai/sdxl-controlnet-union/image-to-image — SDXL img2img driven by
# multiple ControlNets from the source image at once. This is the
# render-to-real recipe (rendair-style).
# FAL_MODEL="fal-ai/sdxl-controlnet-union/image-to-image"

# Fal model tuning (R14 render-to-real operating point). The provider is
# tuned to "swap materials, don't redesign": clean edges + low denoise +
# firm ControlNet. Every knob below is optional — the built-in defaults
# are the shipped config.
#
# FAL_CONTROLS (default "teed,depth")
#   Which ControlNets drive generation, comma-separated. This endpoint
#   supports: canny, teed, depth, normal, openpose, segmentation.
#   (lineart/mlsd are NOT available here — teed is the clean-edge
#   alternative to canny that ignores render/texture noise.)
#   - teed,depth  → default: clean structural edges + 3D depth
#   - canny,depth → the previous recipe; canny picks up more noise
#   An unknown value warns in the server log and falls back to teed,depth.
#
# FAL_CONTROLNET_SCALE (default 0.8)
#   ControlNet conditioning weight. Higher = textures forced to stay
#   strictly inside the source structure.
#   - 0.6  → looser; more material freedom, slight geometry risk
#   - 0.8  → default: firm structure hold at the low denoise we run
#   - 0.9+ → can look "traced"
#
# FAL_INFERENCE_STEPS (default 30)  ·  FAL_GUIDANCE_SCALE (default 7.5)
#   Steps = quality/speed; guidance = how firmly the prompt is followed
#   (7.5 is the SDXL canonical value).
#
# NOTE: img2img denoise (strength) is NOT an env var — it comes from the
# workspace "Kreativitás" slider (default 0.35, range 0.10..0.70). Lower
# = more faithful to source geometry.
#
# FAL_CONTROLS="teed,depth"
# FAL_CONTROLNET_SCALE="0.8"
# FAL_INFERENCE_STEPS="30"
# FAL_GUIDANCE_SCALE="7.5"

# ─── Email (registration approval workflow, Sprint E) ──────────────────────
# Resend API key (https://resend.com). When unset, the email service
# falls back to a console logger so dev still works without a provider.
RESEND_API_KEY=""

# "From" header on every transactional email. Use a verified Resend
# domain in production, e.g. "FormaVeris <noreply@formaveris.hu>".
EMAIL_FROM="FormaVeris <noreply@formaveris.hu>"

# Inbox that receives new-registration notifications with the
# Jóváhagyom / Elutasítom links.
ADMIN_NOTIFY_EMAIL="info@g2amarketing.hu"

# Public site origin — drives canonical URLs, OG image paths, sitemap
# entries, and the absolute links inside transactional emails. In
# development override to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://formaveris.hu"

# ─── OpenAI (legacy — not recommended for architectural fidelity) ──────────
# RENDER2REAL_PROVIDER_API_KEY takes priority over OPENAI_API_KEY so a
# system-level OpenAI key elsewhere on the machine cannot accidentally
# hijack this project's intended key.
RENDER2REAL_PROVIDER_API_KEY=""
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# ─── Production deploy notes (Railway / Fly / Neon / etc.) ─────────────────
#
# These variables become *required* in production (NODE_ENV=production):
#   - DATABASE_URL                   (injected by the platform's Postgres add-on)
#   - RENDER2REAL_SESSION_SECRET     (process refuses to start without it)
#   - RENDER2REAL_STORAGE_ROOT       (point at the mounted persistent volume)
#   - FAL_KEY                        (required only if you keep fal-controlnet active)
#
# Railway also auto-injects:
#   - PORT                           (the port the Next.js server must bind to;
#                                     `next start` reads this automatically)
#   - RAILWAY_PROJECT_ID, RAILWAY_ENVIRONMENT, RAILWAY_SERVICE_NAME (metadata)
